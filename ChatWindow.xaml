<Window x:Class="MzansiShield.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MzansiShield - Chat" Height="620" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        ResizeMode="CanMinimize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontFamily="Courier New" FontSize="18" FontWeight="Bold"
                   Foreground="#00FF41"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>

        <TextBlock Text="MzansiShield is active"
                   Grid.Row="1"
                   FontFamily="Courier New" FontSize="11"
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- Chat display -->
        <Border Grid.Row="2"
                BorderBrush="#00FF41"
                BorderThickness="1"
                Background="#0A0A0A"
                Margin="0,0,0,12">

            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChatDisplay"
                           FontFamily="Courier New" FontSize="13"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           Padding="10"/>
            </ScrollViewer>
        </Border>

        <!-- Topic hints -->
        <TextBlock Grid.Row="3"
                   Text="Topics: phishing | scams | passwords | links | email | privacy"
                   FontFamily="Courier New" FontSize="11"
                   Foreground="#FFD700"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Input area -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput"
                     Grid.Column="0"
                     Height="38"
                     FontFamily="Courier New" FontSize="13"
                     Background="#1A1A1A"
                     Foreground="#00FF41"
                     BorderBrush="#00FF41"
                     BorderThickness="1"
                     Padding="8,4"
                     CaretBrush="#00FF41"
                     Margin="0,0,8,0"
                     KeyDown="UserInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="SEND"
                    Width="90" Height="38"
                    FontFamily="Courier New" FontSize="13" FontWeight="Bold"
                    Background="#00FF41"
                    Foreground="#0D0D0D"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>