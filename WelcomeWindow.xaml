<Window x:Class="MzansiShield.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MzansiShield" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        ResizeMode="CanMinimize">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- ASCII Logo -->
            <TextBlock FontFamily="Courier New" FontSize="8"
                       Foreground="#FFD700"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,10"><![CDATA[
▄▄▄     ▄▄▄                              ▄▄▄▄▄                 ▄▄              ▄▄
███▄ ▄███                              ██▀▀▀▀█▄ █▄             ██    █▄     ▄█▀▀█▄
██ ▀█▀ ██               ▄           ▀▀ ▀██▄  ▄▀ ██    ▀▀       ██    ██     ██  ██
██     ██   ▀▀▀██ ▄▀▀█▄ ████▄ ▄██▀█ ██   ▀██▄▄  ████▄ ██ ▄█▀█▄ ██ ▄████     ██▀▀██
██     ██     ▄█▀ ▄█▀██ ██ ██ ▀███▄ ██ ▄   ▀██▄ ██ ██ ██ ██▄█▀ ██ ██ ██   ▄ ██  ██
▀██▀  ▀██▄▄▄██▄▄▄▀█▄██▄██ ▀██▄▄██▀▄██ ▀██████▀▄██ ██▄██▄▀█▄▄▄▄██▄█▀███   ▀██▀  ▀█▄
            ]]></TextBlock>

            <!-- Title -->
            <TextBlock Text="MZANSISHIELD ASSISTANT"
                       FontFamily="Courier New" FontSize="22" FontWeight="Bold"
                       Foreground="#00FF41"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,4"/>

            <TextBlock Text="Your Cybersecurity Assistant"
                       FontFamily="Courier New" FontSize="13"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Separator line -->
            <Rectangle Height="1" Width="400" Fill="#00FF41" Margin="0,0,0,30"/>

            <!-- Name input -->
            <TextBlock Text="What is your name?"
                       FontFamily="Courier New" FontSize="14"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBox x:Name="NameInput"
                     Width="300" Height="36"
                     FontFamily="Courier New" FontSize="14"
                     Background="#1A1A1A"
                     Foreground="#00FF41"
                     BorderBrush="#00FF41"
                     BorderThickness="1"
                     Padding="8,4"
                     CaretBrush="#00FF41"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,20"/>

            <!-- Start button -->
            <Button x:Name="StartButton"
                    Content="LET'S GO"
                    Width="200" Height="40"
                    FontFamily="Courier New" FontSize="14" FontWeight="Bold"
                    Background="#00FF41"
                    Foreground="#0D0D0D"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Click="StartButton_Click"/>

            <!-- Status message -->
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontFamily="Courier New" FontSize="11"
                       Foreground="#FFD700"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>

        </StackPanel>
    </Grid>
    </Window>